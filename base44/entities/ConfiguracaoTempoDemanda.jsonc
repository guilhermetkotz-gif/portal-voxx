{
  "name": "ConfiguracaoTempoDemanda",
  "type": "object",
  "properties": {
    "tipo_demanda": {
      "type": "string",
      "description": "Tipo/setor da demanda (ex: CRIACAO, EDICAO)"
    },
    "setor_principal": {
      "type": "string",
      "description": "Setor principal (enum igual \u00e0 entidade Demanda)"
    },
    "subcategoria": {
      "type": "string",
      "description": "Subcategoria espec\u00edfica da demanda (prioridade m\u00e1xima na busca)"
    },
    "tempo_limite_minutos": {
      "type": "number",
      "description": "Tempo limite esperado em minutos"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se esta configura\u00e7\u00e3o est\u00e1 ativa"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas"
    }
  },
  "required": [
    "tempo_limite_minutos"
  ]
}