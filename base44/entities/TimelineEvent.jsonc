{
  "name": "TimelineEvent",
  "type": "object",
  "properties": {
    "demanda_id": {
      "type": "string",
      "description": "ID da demanda relacionada"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "item_demanda_id": {
      "type": "string",
      "description": "ID do ItemDemanda vinculado (eventos espec\u00edficos de entrega/vers\u00e3o/aprova\u00e7\u00e3o de item). null em eventos gerais."
    },
    "entrega_demanda_id": {
      "type": "string",
      "description": "ID da EntregaDemanda vinculada (eventos espec\u00edficos de vers\u00e3o/entrega). null em eventos gerais."
    },
    "versao_uid": {
      "type": "string",
      "description": "UID da VersaoEntregaDemanda vinculada (modelo entidade_versao). null no modelo embutido."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "status_change",
        "comentario",
        "anexo",
        "criacao",
        "acao_voxx",
        "alteracao_manual",
        "entrega_criada",
        "versao_enviada",
        "aprovacao_solicitada",
        "ajustes_solicitados",
        "nova_versao_enviada",
        "versao_aprovada",
        "item_reaberto",
        "versao_cancelada",
        "conflito_versao",
        "reconciliacao"
      ],
      "description": "Tipo do evento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do evento"
    },
    "autor": {
      "type": "string",
      "description": "Quem realizou a a\u00e7\u00e3o"
    },
    "autor_tipo": {
      "type": "string",
      "enum": [
        "cliente",
        "voxx"
      ],
      "description": "Tipo do autor"
    },
    "status_anterior": {
      "type": "string",
      "description": "Status antes da mudan\u00e7a"
    },
    "status_novo": {
      "type": "string",
      "description": "Status ap\u00f3s mudan\u00e7a"
    },
    "anexo_url": {
      "type": "string",
      "description": "URL do anexo se houver"
    }
  },
  "required": [
    "demanda_id",
    "cliente_id",
    "tipo",
    "descricao"
  ]
}