{
  "name": "EntregaDemanda",
  "type": "object",
  "properties": {
    "demanda_id": {
      "type": "string",
      "description": "ID da demanda vinculada"
    },
    "demanda_titulo": {
      "type": "string",
      "description": "T\u00edtulo da demanda (cache)"
    },
    "item_demanda_id": {
      "type": "string",
      "description": "ID do ItemDemanda vinculado (obrigat\u00f3rio em demandas compostas; null em unit\u00e1rias/legadas). Imut\u00e1vel ap\u00f3s cria\u00e7\u00e3o."
    },
    "item_titulo": {
      "type": "string",
      "description": "T\u00edtulo do item (cache, para exibi\u00e7\u00e3o)"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "nome_entrega": {
      "type": "string",
      "description": "Nome da entrega"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da entrega"
    },
    "tipo_entrega": {
      "type": "string",
      "enum": [
        "Imagem",
        "V\u00eddeo",
        "Landing Page",
        "Documento",
        "PDF",
        "Link",
        "Relat\u00f3rio",
        "Automa\u00e7\u00e3o",
        "Outro"
      ],
      "description": "Tipo da entrega"
    },
    "status_entrega": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado",
        "em_aprovacao",
        "aprovado",
        "solicitacao_alteracao",
        "reenviado",
        "publicado",
        "arquivado"
      ],
      "default": "rascunho"
    },
    "arquivos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      }
    },
    "link_externo": {
      "type": "string",
      "description": "Link externo (Drive, Vimeo, etc.)"
    },
    "observacao_interna": {
      "type": "string"
    },
    "observacao_cliente": {
      "type": "string"
    },
    "observacao_voxx": {
      "type": "string",
      "description": "Mensagem vis\u00edvel ao cliente na p\u00e1gina p\u00fablica"
    },
    "retorno_cliente_tratado": {
      "type": "boolean",
      "default": true,
      "description": "Se o retorno do cliente (aprova\u00e7\u00e3o/altera\u00e7\u00e3o) j\u00e1 foi tratado pela equipe. false = pendente de a\u00e7\u00e3o."
    },
    "data_envio": {
      "type": "string",
      "format": "date-time"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time"
    },
    "usuario_envio": {
      "type": "string"
    },
    "usuario_envio_nome": {
      "type": "string"
    },
    "usuario_envio_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio Base44 que enviou a entrega/vers\u00e3o"
    },
    "usuario_aprovacao": {
      "type": "string"
    },
    "token_publico": {
      "type": "string",
      "description": "Token \u00fanico para link p\u00fablico de aprova\u00e7\u00e3o"
    },
    "link_publico_aprovacao": {
      "type": "string",
      "description": "URL completa do link p\u00fablico"
    },
    "link_ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se o link p\u00fablico est\u00e1 ativo"
    },
    "link_expira_em": {
      "type": "string",
      "format": "date-time",
      "description": "Expira\u00e7\u00e3o opcional do link"
    },
    "versao_ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se esta \u00e9 a vers\u00e3o ativa do item. false = vers\u00e3o arquivada/substitu\u00edda."
    },
    "numero_versao_atual": {
      "type": "number",
      "default": 1
    },
    "versoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "arquivos": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "link_externo": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          },
          "usuario_nome": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          },
          "status_versao": {
            "type": "string",
            "enum": [
              "substituida",
              "arquivada",
              "aprovada_anteriormente",
              "reprovada",
              "ativa"
            ],
            "description": "Estado da vers\u00e3o no hist\u00f3rico"
          }
        }
      }
    },
    "historico_aprovacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acao": {
            "type": "string"
          },
          "nome_responsavel": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "ip": {
            "type": "string"
          },
          "versao": {
            "type": "number"
          }
        }
      }
    },
    "modelo_versionamento": {
      "type": "string",
      "enum": [
        "embutido",
        "entidade_versao"
      ],
      "default": "embutido",
      "description": "Modelo de versionamento desta entrega. 'embutido' = vers\u00f5es no array versoes[] (legado, demandas unit\u00e1rias/tradicionais). 'entidade_versao' = vers\u00f5es em VersaoEntregaDemanda separada (Fase 2A, demandas compostas novas). Definido na cria\u00e7\u00e3o; imut\u00e1vel ap\u00f3s."
    },
    "versao_atual_uid_cache": {
      "type": "string",
      "description": "Cache do versao_uid da vers\u00e3o vigente. N\u00c3O \u00e9 fonte de verdade \u2014 derivado de VersaoEntregaDemanda pela ordena\u00e7\u00e3o can\u00f4nica."
    },
    "numero_versao_atual_cache": {
      "type": "number",
      "description": "Cache do n\u00famero da vers\u00e3o vigente. N\u00c3O \u00e9 fonte de verdade."
    },
    "status_entrega_cache": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado",
        "em_aprovacao",
        "aprovado",
        "solicitacao_alteracao",
        "reenviado",
        "publicado",
        "arquivado"
      ],
      "description": "Cache do status da vers\u00e3o vigente. N\u00c3O \u00e9 fonte de verdade."
    },
    "token_publico_cache": {
      "type": "string",
      "description": "Cache do token p\u00fablico da vers\u00e3o vigente. N\u00c3O \u00e9 fonte de verdade."
    },
    "tem_conflito_versao": {
      "type": "boolean",
      "default": false,
      "description": "Cache indicando se h\u00e1 m\u00faltiplas vers\u00f5es candidatas concorrentes. Atualizado pela reconcilia\u00e7\u00e3o."
    },
    "ultima_sincronizacao_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima sincroniza\u00e7\u00e3o de caches com a vers\u00e3o can\u00f4nica."
    }
  },
  "required": [
    "demanda_id",
    "nome_entrega",
    "tipo_entrega"
  ]
}