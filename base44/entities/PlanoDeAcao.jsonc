{
  "name": "PlanoDeAcao",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "titulo_plano": {
      "type": "string",
      "description": "T\u00edtulo do plano de a\u00e7\u00e3o"
    },
    "descricao_resumida": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o resumida do plano"
    },
    "objetivo_geral": {
      "type": "string",
      "description": "Objetivo geral do plano"
    },
    "data_abertura": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura do plano"
    },
    "status_plano": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em andamento",
        "Conclu\u00eddo",
        "Arquivado"
      ],
      "default": "Aberto",
      "description": "Status do plano"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas"
    }
  },
  "required": [
    "cliente_id",
    "titulo_plano",
    "objetivo_geral",
    "data_abertura"
  ]
}