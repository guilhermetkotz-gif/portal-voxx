{
  "name": "InteracaoComercial",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead relacionado"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "ligacao",
        "whatsapp",
        "email",
        "reuniao",
        "proposta",
        "nota",
        "status_change"
      ],
      "description": "Tipo de intera\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da intera\u00e7\u00e3o"
    },
    "autor": {
      "type": "string",
      "description": "Email de quem registrou"
    },
    "autor_nome": {
      "type": "string",
      "description": "Nome de quem registrou"
    },
    "status_anterior": {
      "type": "string",
      "description": "Etapa anterior (para mudan\u00e7as de status)"
    },
    "status_novo": {
      "type": "string",
      "description": "Nova etapa"
    }
  },
  "required": [
    "lead_id",
    "tipo",
    "descricao"
  ]
}