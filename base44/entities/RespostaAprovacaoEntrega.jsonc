{
  "name": "RespostaAprovacaoEntrega",
  "type": "object",
  "properties": {
    "entrega_id": {
      "type": "string",
      "description": "ID da EntregaDemanda"
    },
    "versao_entrega_demanda_id": {
      "type": "string",
      "description": "ID do registro VersaoEntregaDemanda respondido (modelo entidade_versao). null no modelo embutido."
    },
    "versao_uid": {
      "type": "string",
      "description": "UID da vers\u00e3o respondida (modelo entidade_versao). null no modelo embutido."
    },
    "demanda_id": {
      "type": "string",
      "description": "ID da demanda"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "token_publico": {
      "type": "string",
      "description": "Token do link utilizado"
    },
    "numero_versao": {
      "type": "number",
      "description": "Vers\u00e3o da entrega que foi respondida"
    },
    "tipo_resposta": {
      "type": "string",
      "enum": [
        "aprovado",
        "solicitou_alteracao"
      ],
      "description": "Tipo da resposta do cliente"
    },
    "nome_responsavel": {
      "type": "string",
      "description": "Nome informado pelo cliente"
    },
    "observacao_cliente": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o da altera\u00e7\u00e3o ou aprova\u00e7\u00e3o"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      },
      "description": "Anexos enviados pelo cliente"
    },
    "link_alteracao": {
      "type": "string",
      "description": "Link de refer\u00eancia para altera\u00e7\u00e3o"
    },
    "data_resposta": {
      "type": "string",
      "format": "date-time"
    },
    "ip": {
      "type": "string",
      "description": "IP de origem"
    },
    "user_agent": {
      "type": "string",
      "description": "User-Agent do navegador"
    },
    "operacao_id": {
      "type": "string",
      "description": "ID da OperacaoEntrega que processou esta resposta (modelo entidade_versao)"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Chave de idempot\u00eancia enviada pelo cliente (modelo entidade_versao)"
    },
    "status_aplicacao": {
      "type": "string",
      "enum": [
        "pendente_aplicacao",
        "aplicada",
        "falha_aplicacao",
        "duplicada"
      ],
      "default": "pendente_aplicacao",
      "description": "Status da aplica\u00e7\u00e3o da resposta no sistema. 'pendente_aplicacao' = resposta registrada mas ainda n\u00e3o aplicada na vers\u00e3o. 'aplicada' = vers\u00e3o atualizada com sucesso. 'falha_aplicacao' = falha ao aplicar. 'duplicada' = resposta duplicada ignorada."
    },
    "aplicada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a resposta foi aplicada na vers\u00e3o"
    },
    "erro_aplicacao_detalhe": {
      "type": "string",
      "description": "Detalhe do erro quando status_aplicacao = falha_aplicacao"
    }
  },
  "required": [
    "entrega_id",
    "tipo_resposta",
    "nome_responsavel"
  ]
}