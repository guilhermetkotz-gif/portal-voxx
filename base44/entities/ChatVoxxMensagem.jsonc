  "name": "ChatVoxxMensagem",
  "type": "object",
  "properties": {
    "conversa_id": {
      "type": "string",
      "description": "ID da conversa vinculada"
    },
    "remetente_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio remetente"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do remetente (cache)"
    },
    "conteudo": {
