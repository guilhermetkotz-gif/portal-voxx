{
  "name": "Newsletter",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do comunicado"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado em markdown"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "otimizacao",
        "boas_praticas",
        "tendencias",
        "comunicado",
        "novidade"
      ],
      "description": "Categoria do insight"
    },
    "segmento": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Segmentos de clientes (oral_sin, particular, etc)"
    },
    "publicado": {
      "type": "boolean",
      "default": false,
      "description": "Se est\u00e1 publicado"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date",
      "description": "Data de publica\u00e7\u00e3o"
    },
    "imagem_url": {
      "type": "string",
      "description": "Imagem de capa"
    }
  },
  "required": [
    "titulo",
    "conteudo",
    "categoria"
  ]
}