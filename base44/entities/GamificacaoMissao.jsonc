{
  "name": "GamificacaoMissao",
  "type": "object",
  "properties": {
    "analista_id": {
      "type": "string",
      "description": "ID do analista (usu\u00e1rio)"
    },
    "analista_nome": {
      "type": "string",
      "description": "Nome do analista"
    },
    "data_geracao": {
      "type": "string",
      "format": "date",
      "description": "Data para qual a miss\u00e3o foi gerada"
    },
    "conta_meta_ads_id": {
      "type": "string",
      "description": "ID da conta Meta Ads"
    },
    "account_name": {
      "type": "string",
      "description": "Nome da conta"
    },
    "tipo_prioridade": {
      "type": "string",
      "enum": [
        "critica",
        "alta",
        "media",
        "baixa"
      ],
      "description": "N\u00edvel de prioridade baseado no radar"
    },
    "radar_score": {
      "type": "number",
      "description": "Score do radar no momento da gera\u00e7\u00e3o"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo da miss\u00e3o (problema identificado)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_execucao",
        "concluida",
        "nao_aplicavel"
      ],
      "default": "pendente",
      "description": "Status da miss\u00e3o"
    },
    "acao_realizada": {
      "type": "string",
      "description": "Tipo de a\u00e7\u00e3o realizada (se conclu\u00edda)"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o do analista"
    },
    "pontos": {
      "type": "number",
      "description": "Pontos ganhos pela conclus\u00e3o"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi conclu\u00edda"
    }
  },
  "required": [
    "analista_id",
    "data_geracao",
    "account_name",
    "tipo_prioridade",
    "motivo"
  ]
}