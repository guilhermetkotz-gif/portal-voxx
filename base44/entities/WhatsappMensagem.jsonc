{
  "name": "WhatsappMensagem",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "ID \u00fanico da mensagem no WhatsApp"
    },
    "raw_id": {
      "type": "string",
      "description": "ID do WhatsappWebhookRaw de origem"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "grupo_id": {
      "type": "string"
    },
    "grupo_nome": {
      "type": "string"
    },
    "grupo_id_normalizado": {
      "type": "string",
      "description": "ID do grupo no formato padronizado (numeric-group)"
    },
    "is_group": {
      "type": "boolean",
      "default": true
    },
    "remetente_nome": {
      "type": "string"
    },
    "remetente_telefone": {
      "type": "string"
    },
    "remetente_tipo": {
      "type": "string",
      "enum": [
        "voxx",
        "cliente",
        "desconhecido"
      ],
      "default": "desconhecido"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio Base44 que enviou a mensagem (apenas para mensagens enviadas via VOXX pela plataforma)"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que enviou (cache)"
    },
    "origem": {
      "type": "string",
      "enum": [
        "recebida",
        "enviada",
        "sistema",
        "desconhecida"
      ],
      "default": "recebida"
    },
    "mensagem": {
      "type": "string"
    },
    "tipo_mensagem": {
      "type": "string",
      "enum": [
        "texto",
        "imagem",
        "video",
        "audio",
        "documento",
        "sticker",
        "reacao",
        "sistema",
        "atividade",
        "sem_conteudo"
      ],
      "default": "texto"
    },
    "midia_url": {
      "type": "string",
      "description": "URL da m\u00eddia (imagem, v\u00eddeo, \u00e1udio, documento)"
    },
    "midia_mimetype": {
      "type": "string",
      "description": "MIME type da m\u00eddia"
    },
    "midia_nome": {
      "type": "string",
      "description": "Nome original do arquivo de m\u00eddia"
    },
    "transcricao_audio": {
      "type": "string",
      "description": "Transcri\u00e7\u00e3o do \u00e1udio gerada automaticamente via Speech-to-Text"
    },
    "transcricao_status": {
      "type": "string",
      "enum": [
        "pendente",
        "processando",
        "concluida",
        "erro"
      ],
      "description": "Status do processamento da transcri\u00e7\u00e3o de \u00e1udio"
    },
    "timestamp_mensagem": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "from_me": {
      "type": "boolean",
      "default": false
    },
    "status_entrega": {
      "type": "string",
      "enum": [
        "pendente",
        "enviado",
        "entregue",
        "lido",
        "erro"
      ],
      "default": "pendente",
      "description": "Status de entrega da mensagem"
    },
    "status_processamento": {
      "type": "string",
      "enum": [
        "ok",
        "sem_vinculo",
        "erro"
      ],
      "default": "ok"
    },
    "citacao_id": {
      "type": "string",
      "description": "ID da mensagem que est\u00e1 sendo citada"
    },
    "citacao_texto": {
      "type": "string",
      "description": "Texto da mensagem citada"
    },
    "citacao_remetente": {
      "type": "string",
      "description": "Nome do remetente da mensagem citada"
    },
    "citacao_tipo": {
      "type": "string",
      "enum": [
        "texto",
        "imagem",
        "video",
        "audio",
        "documento",
        "sticker"
      ]
    },
    "citacao_midia_url": {
      "type": "string",
      "description": "URL da m\u00eddia da mensagem citada"
    },
    "deletado": {
      "type": "boolean",
      "default": false,
      "description": "Mensagem foi exclu\u00edda (para todos)"
    },
    "deletado_por": {
      "type": "string",
      "description": "Email de quem excluiu"
    },
    "deletado_em": {
      "type": "string",
      "format": "date-time"
    },
    "reacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "remetente": {
            "type": "string"
          },
          "remetente_telefone": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Rea\u00e7\u00f5es (emojis) recebidas nesta mensagem"
    }
  },
  "required": [
    "received_at"
  ]
}