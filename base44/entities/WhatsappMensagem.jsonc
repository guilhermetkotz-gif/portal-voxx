{
  "name": "WhatsappMensagem",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "ID \u00fanico da mensagem no WhatsApp"
    },
    "raw_id": {
      "type": "string",
      "description": "ID do WhatsappWebhookRaw de origem"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "grupo_id": {
      "type": "string"
    },
    "grupo_nome": {
      "type": "string"
    },
    "grupo_id_normalizado": {
      "type": "string",
      "description": "ID do grupo no formato padronizado (numeric-group)"
    },
    "is_group": {
      "type": "boolean",
      "default": true
    },
    "remetente_nome": {
      "type": "string"
    },
    "remetente_telefone": {
      "type": "string"
    },
    "remetente_tipo": {
      "type": "string",
      "enum": [
        "voxx",
        "cliente",
        "desconhecido"
      ],
      "default": "desconhecido"
    },
    "origem": {
      "type": "string",
      "enum": [
        "recebida",
        "enviada",
        "sistema",
        "desconhecida"
      ],
      "default": "recebida"
    },
    "mensagem": {
      "type": "string"
    },
    "tipo_mensagem": {
      "type": "string",
      "enum": [
        "texto",
        "imagem",
        "video",
        "audio",
        "documento",
        "sticker",
        "sistema",
        "atividade",
        "sem_conteudo"
      ],
      "default": "texto"
    },
    "midia_url": {
      "type": "string",
      "description": "URL da m\u00eddia (imagem, v\u00eddeo, \u00e1udio, documento)"
    },
    "midia_mimetype": {
      "type": "string",
      "description": "MIME type da m\u00eddia"
    },
    "midia_nome": {
      "type": "string",
      "description": "Nome original do arquivo de m\u00eddia"
    },
    "timestamp_mensagem": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp original da mensagem"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi recebido no webhook"
    },
    "from_me": {
      "type": "boolean",
      "default": false
    },
    "status_processamento": {
      "type": "string",
      "enum": [
        "ok",
        "sem_vinculo",
        "erro"
      ],
      "default": "ok"
    },
    "citacao_id": {
      "type": "string",
      "description": "ID da mensagem que est\u00e1 sendo citada (resposta a)"
    },
    "citacao_texto": {
      "type": "string",
      "description": "Texto da mensagem citada"
    },
    "citacao_remetente": {
      "type": "string",
      "description": "Nome do remetente da mensagem citada"
    },
    "citacao_tipo": {
      "type": "string",
      "enum": [
        "texto",
        "imagem",
        "video",
        "audio",
        "documento",
        "sticker"
      ],
      "description": "Tipo da mensagem citada"
    },
    "citacao_midia_url": {
      "type": "string",
      "description": "URL da m\u00eddia da mensagem citada (se for imagem/sticker)"
    }
  },
  "required": [
    "received_at"
  ]
}