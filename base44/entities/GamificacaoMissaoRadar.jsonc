{
  "name": "GamificacaoMissaoRadar",
  "type": "object",
  "properties": {
    "data_missao": {
      "type": "string",
      "format": "date",
      "description": "Data da miss\u00e3o (YYYY-MM-DD)"
    },
    "responsavel_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel pela unidade"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "responsavel_email": {
      "type": "string",
      "description": "Email do respons\u00e1vel"
    },
    "unidade_id": {
      "type": "string",
      "description": "ID do cliente/unidade"
    },
    "unidade_nome": {
      "type": "string",
      "description": "Nome da unidade (account_name)"
    },
    "prioridade_radar": {
      "type": "string",
      "enum": [
        "critica",
        "alta",
        "media",
        "baixa"
      ],
      "description": "Prioridade do RADAR META (Estado x Tend\u00eancia)"
    },
    "estado_estrutural": {
      "type": "string",
      "enum": [
        "critico",
        "atencao",
        "operacional",
        "saudavel"
      ],
      "description": "Estado estrutural da conta (7d)"
    },
    "tendencia_recente": {
      "type": "string",
      "enum": [
        "negativa",
        "neutra",
        "positiva"
      ],
      "description": "Tend\u00eancia recente (ontem vs 7d)"
    },
    "radar_score": {
      "type": "number",
      "description": "Score do RADAR META (0-100)"
    },
    "motivo": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do problema/oportunidade"
    },
    "alertas_especiais": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alertas especiais (ex: gasto sem convers\u00e3o, satura\u00e7\u00e3o cr\u00edtica)"
    },
    "metricas_radar": {
      "type": "object",
      "description": "M\u00e9tricas do RADAR para refer\u00eancia",
      "properties": {
        "cpl_atual": {
          "type": "number"
        },
        "cpl_7d": {
          "type": "number"
        },
        "ctr_atual": {
          "type": "number"
        },
        "frequencia_7d": {
          "type": "number"
        },
        "leads_ontem": {
          "type": "number"
        },
        "investimento_diario": {
          "type": "number"
        }
      }
    },
    "previsao_7d": {
      "type": "object",
      "description": "Previs\u00e3o 7 dias",
      "properties": {
        "radar_score": {
          "type": "number"
        },
        "delta": {
          "type": "number"
        },
        "confianca": {
          "type": "string",
          "enum": [
            "alta",
            "media",
            "baixa"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_execucao",
        "concluida",
        "nao_aplicavel"
      ],
      "default": "pendente",
      "description": "Status da miss\u00e3o"
    },
    "acao_aplicada": {
      "type": "string",
      "description": "Tipo de a\u00e7\u00e3o aplicada (do banco de a\u00e7\u00f5es)"
    },
    "descricao_acao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da a\u00e7\u00e3o executada"
    },
    "evidencia_url": {
      "type": "string",
      "description": "URL de evid\u00eancia (screenshot, link, etc)"
    },
    "tempo_conclusao_minutos": {
      "type": "number",
      "description": "Tempo entre cria\u00e7\u00e3o e conclus\u00e3o (minutos)"
    },
    "pontos_ganhos": {
      "type": "number",
      "default": 0,
      "description": "Pontos ganhos na conclus\u00e3o"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de conclus\u00e3o"
    }
  },
  "required": [
    "data_missao",
    "responsavel_user_id",
    "unidade_id",
    "prioridade_radar",
    "motivo"
  ]
}