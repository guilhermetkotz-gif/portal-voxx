{
  "name": "CopilotConhecimentoVersao",
  "type": "object",
  "properties": {
    "orientacao_id": {
      "type": "string",
      "description": "ID do registro CopilotConhecimento vinculado"
    },
    "versao": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo naquela vers\u00e3o"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado naquela vers\u00e3o"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria naquela vers\u00e3o"
    },
    "tipo_orientacao": {
      "type": "string",
      "description": "Tipo de orienta\u00e7\u00e3o naquela vers\u00e3o"
    },
    "escopo_tipo": {
      "type": "string",
      "description": "Tipo de escopo naquela vers\u00e3o"
    },
    "escopo_segmento": {
      "type": "string",
      "description": "Segmento naquela vers\u00e3o"
    },
    "escopo_marca": {
      "type": "string",
      "description": "Marca naquela vers\u00e3o"
    },
    "escopo_cliente_id": {
      "type": "string",
      "description": "Cliente relacionado naquela vers\u00e3o"
    },
    "escopo_cliente_nome": {
      "type": "string",
      "description": "Nome do cliente em cache naquela vers\u00e3o"
    },
    "chave_tematica": {
      "type": "string",
      "description": "Chave tem\u00e1tica naquela vers\u00e3o"
    },
    "prioridade": {
      "type": "number",
      "description": "Prioridade naquela vers\u00e3o"
    },
    "palavras_chave": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palavras-chave naquela vers\u00e3o"
    },
    "obrigatoria": {
      "type": "boolean",
      "description": "Obrigatoriedade naquela vers\u00e3o"
    },
    "exige_verificacao": {
      "type": "boolean",
      "description": "Exig\u00eancia de verifica\u00e7\u00e3o naquela vers\u00e3o"
    },
    "ativa": {
      "type": "boolean",
      "description": "Status ativo naquela vers\u00e3o"
    },
    "campos_alterados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de campos modificados nesta edi\u00e7\u00e3o"
    },
    "alterado_por_nome": {
      "type": "string"
    },
    "alterado_por_email": {
      "type": "string"
    },
    "data_alteracao": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_edicao": {
      "type": "string",
      "description": "Justificativa da altera\u00e7\u00e3o"
    },
    "substituiu_orientacao_id": {
      "type": "string",
      "description": "ID da orienta\u00e7\u00e3o substitu\u00edda por esta vers\u00e3o (quando aplic\u00e1vel)"
