{
  "name": "ResumoDiarioCliente",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data de refer\u00eancia do resumo"
    },
    "mensagem_gerada": {
      "type": "string",
      "description": "Mensagem gerada pela IA"
    },
    "mensagem_editada": {
      "type": "string",
      "description": "Mensagem ap\u00f3s edi\u00e7\u00e3o humana (usada no envio)"
    },
    "itens_consolidados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos itens da FilaComunicacaoCliente consolidados"
    },
    "total_acoes": {
      "type": "number",
      "default": 0
    },
    "total_anexos": {
      "type": "number",
      "default": 0
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      }
    },
    "status_revisao": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "cancelado",
        "editado"
      ],
      "default": "pendente"
    },
    "status_envio": {
      "type": "string",
      "enum": [
        "aguardando_revisao",
        "pronto_envio",
        "enviado",
        "erro",
        "cancelado"
      ],
      "default": "aguardando_revisao"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Email de quem aprovou"
    },
    "aprovado_por_nome": {
      "type": "string"
    },
    "aprovado_em": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_grupo_id": {
      "type": "string"
    },
    "whatsapp_grupo_nome": {
      "type": "string"
    },
    "observacao_revisao": {
      "type": "string"
    },
    "gerado_por": {
      "type": "string",
      "description": "Email de quem disparou a gera\u00e7\u00e3o"
    }
  },
  "required": [
    "cliente_id",
    "data"
  ]
}