{
  "name": "ReuniaoComercial",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead relacionado"
    },
    "lead_nome": {
      "type": "string",
      "description": "Nome do lead (cache)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da reuni\u00e3o"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da reuni\u00e3o"
    },
    "duracao_minutos": {
      "type": "number",
      "default": 60,
      "description": "Dura\u00e7\u00e3o estimada em minutos"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "diagnostico",
        "apresentacao",
        "negociacao",
        "follow_up",
        "outro"
      ],
      "default": "diagnostico"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendada",
        "realizada",
        "nao_compareceu",
        "reagendada",
        "cancelada"
      ],
      "default": "agendada"
    },
    "responsavel_voxx": {
      "type": "string",
      "description": "Email do respons\u00e1vel"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "local_link": {
      "type": "string",
      "description": "Local ou link (Google Meet, Zoom, etc)"
    },
    "notas": {
      "type": "string",
      "description": "Notas/ata da reuni\u00e3o"
    }
  },
  "required": [
    "lead_id",
    "titulo",
    "data_hora"
  ]
}