{
  "name": "GoogleAdsAccount",
  "type": "object",
  "properties": {
    "account_name": {
      "type": "string",
      "description": "Nome completo da conta Google Ads"
    },
    "unidade_nome": {
      "type": "string",
      "description": "Nome da unidade extra\u00eddo do account_name"
    },
    "cliente_nome": {
      "type": "string",
      "default": "Oral Sin",
      "description": "Nome do cliente"
    },
    "responsavel_voxx": {
      "type": "string",
      "description": "ID do usu\u00e1rio VOXX respons\u00e1vel pela conta"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Total de cliques"
    },
    "all_conversions": {
      "type": "number",
      "default": 0,
      "description": "Todas as convers\u00f5es"
    },
    "conversions": {
      "type": "number",
      "default": 0,
      "description": "Convers\u00f5es principais"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "description": "Custo total (R$)"
    },
    "cost_per_conversion": {
      "type": "number",
      "default": 0,
      "description": "Custo por convers\u00e3o (R$)"
    },
    "avg_cpc": {
      "type": "number",
      "default": 0,
      "description": "CPC m\u00e9dio (R$)"
    },
    "avg_cpm": {
      "type": "number",
      "default": 0,
      "description": "CPM m\u00e9dio (R$)"
    },
    "optimization_score": {
      "type": "number",
      "default": 0,
      "description": "Score de otimiza\u00e7\u00e3o (0-100)"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Pausada"
      ],
      "default": "Ativa",
      "description": "Status da conta"
    },
    "conta_sem_dados": {
      "type": "boolean",
      "default": false,
      "description": "Conta sem dados (clicks=0, conversions=0, cost=0)"
    },
    "data_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o"
    },
    "fonte_dados": {
      "type": "string",
      "default": "Google Ads Sheet",
      "description": "Fonte dos dados"
    },
    "health_score": {
      "type": "number",
      "default": 0,
      "description": "Score de sa\u00fade da conta (0-100) - calculado automaticamente"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "Saud\u00e1vel",
        "Aten\u00e7\u00e3o",
        "Cr\u00edtico",
        "Urgente",
        "Sem dados"
      ],
      "description": "Status de sa\u00fade da conta - derivado do health_score"
    },
    "ranking_posicao": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o no ranking (1 = melhor)"
    },
    "alertas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de alertas autom\u00e1ticos detectados"
    },
    "prioridade_acao": {
      "type": "string",
      "enum": [
        "Atuar hoje",
        "Alta prioridade",
        "Monitorar",
        "Escalar",
        "Investigar"
      ],
      "description": "Prioridade de a\u00e7\u00e3o - derivada do health_status"
    }
  },
  "required": [
    "account_name",
    "unidade_nome"
  ]
}