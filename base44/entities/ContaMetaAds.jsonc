{
  "name": "ContaMetaAds",
  "type": "object",
  "properties": {
    "account_name": {
      "type": "string",
      "description": "Nome da conta Meta Ads"
    },
    "responsavel_voxx": {
      "type": "string",
      "description": "Email do respons\u00e1vel VOXX pela conta Meta Ads"
    },
    "impressions": {
      "type": "number",
      "description": "Impress\u00f5es"
    },
    "cost_per_messaging": {
      "type": "number",
      "description": "Custo por conversa iniciada"
    },
    "frequency": {
      "type": "number",
      "description": "Frequ\u00eancia"
    },
    "cost_per_unique_link": {
      "type": "number",
      "description": "Custo por clique \u00fanico"
    },
    "page_engagement": {
      "type": "number",
      "description": "Engajamento na p\u00e1gina"
    },
    "page_likes": {
      "type": "number",
      "description": "Curtidas na p\u00e1gina"
    },
    "reach": {
      "type": "number",
      "description": "Alcance"
    },
    "amount_spent": {
      "type": "number",
      "description": "Valor gasto"
    },
    "clicks_all": {
      "type": "number",
      "description": "Total de cliques"
    },
    "cpc": {
      "type": "number",
      "description": "CPC (custo por clique)"
    },
    "messaging_conversations": {
      "type": "number",
      "description": "Conversas iniciadas"
    },
    "cost_per_new_messaging": {
      "type": "number",
      "description": "Custo por nova conex\u00e3o"
    },
    "new_messaging_connections": {
      "type": "number",
      "description": "Novas conex\u00f5es"
    },
    "custo_engajamento": {
      "type": "number",
      "description": "Custo por engajamento"
    },
    "leads_repetidos_percent": {
      "type": "number",
      "description": "Percentual de leads repetidos"
    },
    "leads": {
      "type": "number",
      "description": "Leads (cadastros via formul\u00e1rio)"
    },
    "cadastros_whats": {
      "type": "number",
      "description": "Cadastros + WhatsApp"
    },
    "cpl_meta_ads": {
      "type": "number",
      "description": "CPL Meta Ads (Custo/Conversa direto da planilha \u2014 coluna R)"
    },
    "nota_gpt": {
      "type": "number",
      "description": "Nota GPT (0-100)"
    },
    "classificacao": {
      "type": "string",
      "enum": [
        "ELITE",
        "SAUD\u00c1VEL",
        "OPERACIONAL",
        "ALERTA",
        "CR\u00cdTICO"
      ],
      "description": "Classifica\u00e7\u00e3o da conta"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "P1",
        "P2",
        "P3"
      ],
      "description": "Prioridade de otimiza\u00e7\u00e3o"
    },
    "main_issue": {
      "type": "string",
      "description": "Principal problema identificado"
    }
  },
  "required": [
    "account_name",
    "nota_gpt"
  ]
}