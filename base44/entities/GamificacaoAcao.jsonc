{
  "name": "GamificacaoAcao",
  "type": "object",
  "properties": {
    "analista_id": {
      "type": "string",
      "description": "ID do analista"
    },
    "analista_nome": {
      "type": "string",
      "description": "Nome do analista"
    },
    "conta_meta_ads_id": {
      "type": "string",
      "description": "ID da conta Meta Ads"
    },
    "account_name": {
      "type": "string",
      "description": "Nome da conta"
    },
    "tipo_acao": {
      "type": "string",
      "enum": [
        "otimizacao_criativo",
        "ajuste_segmentacao",
        "ajuste_orcamento",
        "pausa_campanha",
        "ativacao_campanha",
        "teste_ab",
        "expansao_publico",
        "reducao_frequencia",
        "ajuste_lance",
        "outro"
      ],
      "description": "Tipo de a\u00e7\u00e3o executada"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da a\u00e7\u00e3o"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "antes_metricas": {
      "type": "object",
      "description": "M\u00e9tricas antes da a\u00e7\u00e3o (CPL, CTR, Freq, etc)"
    },
    "depois_metricas": {
      "type": "object",
      "description": "M\u00e9tricas depois da a\u00e7\u00e3o (se dispon\u00edvel)"
    },
    "missao_id": {
      "type": "string",
      "description": "ID da miss\u00e3o relacionada (se aplic\u00e1vel)"
    },
    "pontos_ganhos": {
      "type": "number",
      "default": 0,
      "description": "Pontos ganhos pela a\u00e7\u00e3o"
    }
  },
  "required": [
    "analista_id",
    "account_name",
    "tipo_acao",
    "descricao"
  ]
}