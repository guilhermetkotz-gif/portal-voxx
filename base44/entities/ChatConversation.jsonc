{
  "name": "ChatConversation",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que iniciou"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "assunto": {
      "type": "string",
      "description": "Assunto da conversa"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_atendimento",
        "resolvido",
        "fechado"
      ],
      "default": "aberto",
      "description": "Status da conversa"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal",
      "description": "Prioridade"
    },
    "atendente_id": {
      "type": "string",
      "description": "ID do atendente Voxx"
    },
    "atendente_nome": {
      "type": "string",
      "description": "Nome do atendente"
    },
    "ultima_mensagem": {
      "type": "string",
      "description": "Preview da \u00faltima mensagem"
    },
    "ultima_mensagem_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima mensagem"
    },
    "nao_lidas_cliente": {
      "type": "number",
      "default": 0,
      "description": "Mensagens n\u00e3o lidas pelo cliente"
    },
    "nao_lidas_voxx": {
      "type": "number",
      "default": 0,
      "description": "Mensagens n\u00e3o lidas pela equipe Voxx"
    }
  },
  "required": [
    "cliente_id",
    "usuario_id",
    "usuario_email"
  ]
}