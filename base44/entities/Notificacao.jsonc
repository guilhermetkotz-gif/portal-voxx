{
  "name": "Notificacao",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio destinat\u00e1rio"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "demanda_criada",
        "status_alterado",
        "aguardando_cliente",
        "saldo_baixo",
        "resumo_semanal",
        "alerta"
      ],
      "description": "Tipo da notifica\u00e7\u00e3o"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem detalhada"
    },
    "lida": {
      "type": "boolean",
      "default": false,
      "description": "Se foi lida"
    },
    "link": {
      "type": "string",
      "description": "Link para a a\u00e7\u00e3o relacionada"
    },
    "demanda_id": {
      "type": "string",
      "description": "ID da demanda relacionada se houver"
    }
  },
  "required": [
    "tipo",
    "titulo",
    "mensagem"
  ]
}