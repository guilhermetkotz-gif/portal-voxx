{
  "name": "RecebimentoReceita",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita vinculada"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento"
    },
    "valor_principal_pago": {
      "type": "number",
      "description": "Valor principal pago"
    },
    "valor_juros": {
      "type": "number",
      "default": 0,
      "description": "Valor de juros/multa cobrado"
    },
    "valor_desconto": {
      "type": "number",
      "default": 0,
      "description": "Valor de desconto concedido"
    },
    "valor_total_recebido": {
      "type": "number",
      "description": "Total efetivamente recebido (principal + juros - desconto)"
    },
    "tipo_recebimento": {
      "type": "string",
      "enum": [
        "parcial",
        "integral",
        "quitacao_juros",
        "ajuste"
      ],
      "default": "integral",
      "description": "Tipo do recebimento"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL do comprovante de pagamento"
    },
    "comprovante_nome": {
      "type": "string",
      "description": "Nome do arquivo do comprovante"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre o recebimento"
    },
    "registrado_por": {
      "type": "string",
      "description": "Nome/email de quem registrou"
    },
    "mes_referencia": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia da receita (YYYY-MM)"
    }
  },
  "required": [
    "receita_id",
    "data_pagamento",
    "valor_principal_pago",
    "valor_total_recebido"
  ]
}