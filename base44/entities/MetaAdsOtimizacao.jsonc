{
  "name": "MetaAdsOtimizacao",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente vinculado (obrigat\u00f3rio para comunica\u00e7\u00e3o direta)"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "conta_meta_ads_id": {
      "type": "string",
      "description": "ID da Conta Meta Ads"
    },
    "account_name": {
      "type": "string",
      "description": "Nome da conta Meta Ads (cache)"
    },
    "data_acao": {
      "type": "string",
      "format": "date",
      "description": "Data da a\u00e7\u00e3o"
    },
    "status_cliente": {
      "type": "string",
      "enum": [
        "estavel",
        "em_recuperacao",
        "atencao",
        "critico",
        "sem_dados"
      ],
      "default": "estavel",
      "description": "Status do cliente no momento da otimiza\u00e7\u00e3o"
    },
    "problema": {
      "type": "string",
      "description": "Problema identificado"
    },
    "objetivo": {
      "type": "string",
      "description": "Objetivo da otimiza\u00e7\u00e3o"
    },
    "acoes_implementadas": {
      "type": "string",
      "description": "A\u00e7\u00f5es implementadas"
    },
    "resumo_acao": {
      "type": "string",
      "description": "Breve resumo (gerado automaticamente)"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que registrou a otimiza\u00e7\u00e3o"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que registrou a otimiza\u00e7\u00e3o"
    },
    "comunicar_cliente": {
      "type": "boolean",
      "default": true,
      "description": "Comunicar esta a\u00e7\u00e3o ao cliente via WhatsApp"
    },
    "resumo_para_cliente": {
      "type": "string",
      "description": "Resumo curto em linguagem orientada ao cliente"
    },
    "comunicacao_enviada_fila": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conta_meta_ads_id",
    "account_name",
    "data_acao",
    "problema",
    "objetivo",
    "acoes_implementadas"
  ]
}