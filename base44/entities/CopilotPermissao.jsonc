{
  "name": "CopilotPermissao",
  "type": "object",
  "properties": {
    "tipo_usuario": {
      "type": "string",
      "enum": [
        "voxx_admin",
        "voxx_manager",
        "voxx_operacao",
        "voxx_financeiro"
      ],
      "description": "Tipo de usu\u00e1rio VOXX (clientes n\u00e3o t\u00eam registro nesta entidade)"
    },
    "pode_visualizar": {
      "type": "boolean",
      "default": false,
      "description": "Pode visualizar orienta\u00e7\u00f5es"
    },
    "pode_criar": {
      "type": "boolean",
      "default": false,
      "description": "Pode criar orienta\u00e7\u00f5es (respeitando categorias_administraveis)"
    },
    "pode_editar": {
      "type": "boolean",
      "default": false,
      "description": "Pode editar orienta\u00e7\u00f5es (respeitando categorias_administraveis)"
    },
    "pode_ativar_desativar": {
      "type": "boolean",
      "default": false,
      "description": "Pode ativar ou desativar orienta\u00e7\u00f5es (respeitando categorias_administraveis)"
    },
    "pode_visualizar_historico": {
      "type": "boolean",
      "default": false,
      "description": "Pode visualizar hist\u00f3rico de vers\u00f5es"
    },
    "pode_restaurar_versao": {
      "type": "boolean",
      "default": false,
      "description": "Pode restaurar vers\u00f5es anteriores (respeitando categorias_administraveis)"
    },
    "categorias_administraveis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "padrao_comunicacao",
          "campanhas_trafego",
          "criacao_artes",
          "conteudo_redes_sociais",
          "operacao_atendimento",
          "reclamacoes_sensiveis",
          "contratos_financeiro"
        ]
      },
      "default": [],
      "description": "Categorias em que o usu\u00e1rio pode criar/editar/ativar/desativar/restaurar orienta\u00e7\u00f5es. Vazio ou ausente = sem permiss\u00e3o de escrita (acesso negado). Backend valida obrigatoriamente."
    }
  },
  "required": [
    "tipo_usuario"
  ]
}